# Optional override. Relative paths are resolved from the repository root.
RETURNGUARD_MODEL_PATH=models/xgboost.joblib
RETURNGUARD_EXPLANATION_REFERENCE_PATH=models/explanation_reference.json
RETURNGUARD_MODEL_METADATA_PATH=models/model_metadata.json

# Comma-separated browser origins allowed to call the API.
RETURNGUARD_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Public-demo protection and operational metadata.
RETURNGUARD_MAX_CONCURRENT_PREDICTIONS=2
RETURNGUARD_PREDICTION_QUEUE_TIMEOUT_SECONDS=0.25
RETURNGUARD_RATE_LIMIT_PER_MINUTE=30
RETURNGUARD_LOG_LEVEL=INFO
RETURNGUARD_ENVIRONMENT=development
RETURNGUARD_BUILD_SHA=development
